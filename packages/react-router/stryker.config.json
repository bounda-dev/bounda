{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run"
  },
  "mutate": ["src/**/*.ts", "!src/**/*.test.ts", "!src/index.ts"],
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "tempDirName": ".stryker-tmp",
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tsconfigFile": "stryker.no-tsconfig.json",
  "warnings": {
    "unknownOptions": false
  },
  "_comment": "Same runner set-up as packages/core: the command runner because @stryker-mutator/vitest-runner does not activate mutants under Vitest 5, and a deliberately missing tsconfigFile because TypeScript 7 has no JavaScript API for Stryker to read it with.",
  "inPlace": true,
  "timeoutMS": 60000
}
