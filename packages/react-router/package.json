{
  "name": "@bounda-dev/react-router",
  "version": "0.1.0-alpha.7",
  "description": "React Router framework-mode integration for Bounda",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounda-dev/bounda.git",
    "directory": "packages/react-router"
  },
  "homepage": "https://docs.bounda.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@bounda-dev/cli": "workspace:*",
    "@bounda-dev/core": "workspace:*",
    "react-router": ">=8",
    "vite": ">=7"
  },
  "devDependencies": {
    "@bounda-dev/cli": "workspace:*",
    "@bounda-dev/core": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "react": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependenciesMeta": {
    "@bounda-dev/cli": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
