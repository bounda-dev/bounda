{
  "name": "bounda-cloudflare-test",
  "main": "test/test-worker.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "STORE_REGION": "eu-test",
    "BOUNDA_MASTER_KEY": "5hmVukCECFtCyFw3rgVhT/y8hR2OrZBY5JonQlvHN1U="
  },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "Store" },
      { "name": "PROCESS_STORE", "class_name": "ProcessStore" },
      { "name": "QUIET_STORE", "class_name": "QuietStore" },
      { "name": "SLICED_STORE", "class_name": "SlicedStore" },
      { "name": "REGION_STORE", "class_name": "RegionStore" },
      { "name": "RETAINED_STORE", "class_name": "RetainedStore" },
      { "name": "WRAPPED_STORE", "class_name": "WrappedStore" },
      { "name": "BARE", "class_name": "Bare" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Store", "QuietStore", "SlicedStore", "Bare"] },
    { "tag": "v2", "new_sqlite_classes": ["ProcessStore"] },
    { "tag": "v3", "new_sqlite_classes": ["RegionStore"] },
    { "tag": "v4", "new_sqlite_classes": ["RetainedStore"] },
    { "tag": "v5", "new_sqlite_classes": ["WrappedStore"] }
  ]
}
