{
  "name": "@bounda-dev/cli",
  "version": "0.3.0",
  "description": "The bounda CLI: reads the project layout and writes the registry and the types",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounda-dev/bounda.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.bounda.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run"
  },
  "bin": {
    "bounda": "./dist/cli.js"
  },
  "dependencies": {
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@bounda-dev/cloudflare": "workspace:*",
    "@bounda-dev/core": "workspace:*",
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@bounda-dev/cloudflare": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bounda-dev/cloudflare": "workspace:*",
    "@bounda-dev/core": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
