{
  "name": "bounda-adapter-cloudflare-test",
  "main": "test/test-worker.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "Store" },
      { "name": "QUIET_STORE", "class_name": "QuietStore" },
      { "name": "SLICED_STORE", "class_name": "SlicedStore" },
      { "name": "BARE", "class_name": "Bare" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Store", "QuietStore", "SlicedStore", "Bare"] }
  ]
}
