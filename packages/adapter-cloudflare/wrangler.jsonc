{
  "name": "bounda-adapter-cloudflare-test",
  "main": "test/test-worker.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "Store" },
      { "name": "QUIET_STORE", "class_name": "QuietStore" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store", "QuietStore"] }]
}
