{
  "name": "@bounda-dev/adapter-postgresql",
  "version": "0.1.0-alpha.8",
  "description": "PostgreSQL storage adapter for Bounda",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounda-dev/bounda.git",
    "directory": "packages/adapter-postgresql"
  },
  "homepage": "https://docs.bounda.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "postgres": "catalog:"
  },
  "peerDependencies": {
    "@bounda-dev/core": "workspace:*"
  },
  "devDependencies": {
    "@bounda-dev/core": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
