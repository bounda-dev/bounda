{
  "name": "create-bounda",
  "version": "0.1.0-alpha.3",
  "description": "Scaffold a new Bounda project",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bounda-dev/bounda.git",
    "directory": "packages/create-bounda"
  },
  "homepage": "https://docs.bounda.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "template"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:mutation": "stryker run"
  },
  "bin": {
    "create-bounda": "./dist/cli.js"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
