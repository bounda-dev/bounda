{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "target": "es2024",
    "lib": ["dom", "dom.iterable", "es2024"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    // No exactOptionalPropertyTypes: the types React Router generates for
    // virtual:react-router/server-build, which workers/app.ts imports, fail under it.
    "rootDirs": [".", "./.react-router/types"],
    "types": ["./worker-configuration.d.ts", "vite/client", "@cloudflare/vitest-plugin/types"],
    "skipLibCheck": true
  },
  "include": [
    "app",
    "workers",
    "tests",
    ".bounda/**/*",
    ".react-router/types/**/*",
    "bounda.config.ts",
    "react-router.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
