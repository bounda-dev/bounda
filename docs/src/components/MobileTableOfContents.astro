---
import { Icon } from "@astrojs/starlight/components";
import { sectionsOf } from "../sections.ts";
import TocList from "./TocList.astro";

// The table of contents on a narrow screen: a bar under the header that says which section is
// being read, and opens to the same numbered list as the desktop one.
const sections = sectionsOf(Astro.locals.starlightRoute.toc);
const title = Astro.locals.t("tableOfContents.onThisPage");
---

{
  sections.length > 0 && (
    <bounda-mobile-toc>
      <nav aria-label={title}>
        <details>
          <summary>
            <span class="bounda-label">{title}</span>
            <span class="current" />
            <Icon name="down-caret" class="caret" />
          </summary>
          <div class="dropdown">
            <TocList sections={sections} />
          </div>
        </details>
      </nav>
    </bounda-mobile-toc>
  )
}

<script>
  import { followReading } from "../reading.ts";

  class BoundaMobileToc extends HTMLElement {
    connectedCallback() {
      const details = this.querySelector("details");
      const current = this.querySelector(".current");
      if (!details || !current) return;
      const links = [...this.querySelectorAll("a")];
      // The current section as the list shows it: its number, then its title.
      followReading(links, (link) => {
        const copy = link?.cloneNode(true);
        current.replaceChildren(...(copy?.childNodes ?? []));
      });
      const close = () => {
        details.open = false;
      };
      for (const link of links) link.addEventListener("click", close);
      addEventListener("click", (event) => {
        if (!details.contains(event.target as Node)) close();
      });
      addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !details.open) return;
        close();
        details.querySelector("summary")?.focus();
      });
    }
  }
  customElements.define("bounda-mobile-toc", BoundaMobileToc);
</script>

<style>
  nav {
    position: fixed;
    z-index: var(--sl-z-index-toc);
    top: calc(var(--sl-nav-height) - 1px);
    inset-inline: 0;
    border-top: 1px solid var(--sl-color-hairline);
    border-bottom: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-bg-nav);
  }

  @media (min-width: 50rem) {
    nav {
      inset-inline-start: var(--sl-content-inline-start, 0);
    }
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: calc(var(--sl-mobile-toc-height) - 1px);
    padding: 0 1rem;
    cursor: pointer;
    user-select: none;
  }

  summary::marker,
  summary::-webkit-details-marker {
    display: none;
  }

  .bounda-label {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .current {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-white);
  }

  summary :global(.caret) {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
    transition: transform 160ms cubic-bezier(0.22, 0.8, 0.16, 1);
  }

  details[open] summary :global(.caret) {
    transform: rotate(180deg);
  }

  .dropdown {
    max-height: calc(85vh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
    overflow-y: auto;
    padding: 0.5rem 1rem 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    background: var(--sl-color-black);
    overscroll-behavior: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    summary :global(.caret) {
      transition: none;
    }
  }
</style>
