---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type TocItem = NonNullable<StarlightRouteData["toc"]>["items"][number];

interface Props {
  readonly sections: readonly TocItem[];
}

// The sections of a page as a column of positions: each numbered, its subsections under it, on a
// rule whose bright stretch is the section being read.
const { sections } = Astro.props;
---

<ol>
  {
    sections.map((section, index) => (
      <li>
        <a href={`#${section.slug}`}>
          <span class="bounda-number">{String(index + 1).padStart(2, "0")}</span>
          <span>{section.text}</span>
        </a>
        {section.children.length > 0 && (
          <ol>
            {section.children.map((child) => (
              <li>
                <a href={`#${child.slug}`} class="sub">
                  <span>{child.text}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ol>

<style>
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ol:not(ol ol) {
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
    margin-inline-start: -1px;
    padding: 0.25rem 0 0.25rem 0.75rem;
    border-inline-start: 2px solid transparent;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 160ms cubic-bezier(0.22, 0.8, 0.16, 1);
  }

  a.sub {
    display: block;
    padding-inline-start: calc(0.75rem + 1.75rem);
  }

  a:hover,
  a:focus-visible {
    color: var(--sl-color-white);
  }

  a[aria-current="true"] {
    border-inline-start-color: var(--sl-color-white);
    color: var(--sl-color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
