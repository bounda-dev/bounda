---
import { Icon } from "@astrojs/starlight/components";

// The theme as a segmented control instead of a select. It keeps Starlight's storage key, which
// ThemeProvider reads before the page paints.
const themes = [
  { value: "auto", icon: "laptop", label: Astro.locals.t("themeSelect.auto") },
  { value: "dark", icon: "moon", label: Astro.locals.t("themeSelect.dark") },
  { value: "light", icon: "sun", label: Astro.locals.t("themeSelect.light") },
] as const;
---

<bounda-theme-select>
  <div role="group" aria-label={Astro.locals.t("themeSelect.accessibleLabel")}>
    {
      themes.map(({ value, icon, label }) => (
        <button type="button" data-theme={value} aria-pressed="false" aria-label={label} title={label}>
          <Icon name={icon} size="1rem" />
        </button>
      ))
    }
  </div>
</bounda-theme-select>

<script>
  type Theme = "auto" | "dark" | "light";

  const storageKey = "starlight-theme";

  const parseTheme = (theme: unknown): Theme =>
    theme === "dark" || theme === "light" ? theme : "auto";

  const loadTheme = (): Theme => {
    try {
      return parseTheme(localStorage.getItem(storageKey));
    } catch {
      return "auto";
    }
  };

  const systemTheme = (): Theme =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  const apply = (theme: Theme) => {
    document.documentElement.dataset.theme = theme === "auto" ? systemTheme() : theme;
    for (const button of document.querySelectorAll("bounda-theme-select button")) {
      button.setAttribute("aria-pressed", String(button.getAttribute("data-theme") === theme));
    }
    try {
      localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
    } catch {}
  };

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") apply("auto");
  });

  class BoundaThemeSelect extends HTMLElement {
    connectedCallback() {
      apply(loadTheme());
      for (const button of this.querySelectorAll("button")) {
        button.addEventListener("click", () => apply(parseTheme(button.dataset.theme)));
      }
    }
  }
  customElements.define("bounda-theme-select", BoundaThemeSelect);
</script>

<style>
  div {
    display: flex;
    border: 1px solid var(--sl-color-hairline);
  }

  button {
    display: flex;
    padding: 0.375rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }

  button + button {
    border-inline-start: 1px solid var(--sl-color-hairline);
  }

  button:hover,
  button:focus-visible {
    color: var(--sl-color-white);
  }

  button[aria-pressed="true"] {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
</style>
