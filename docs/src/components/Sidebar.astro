---
import { Badge } from "@astrojs/starlight/components";
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import { positionsOf } from "../positions.ts";

// The sidebar as an index of the docs, set like a ledger: every group open, every page with its
// position, the page being read marked as the head. A link outside a group has no position.
const { sidebar } = Astro.locals.starlightRoute;
---

<SidebarPersister>
  <div class="bounda-index">
    {
      sidebar.map((entry, index) =>
        entry.type === "link" ? (
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? "page" : undefined}
            {...entry.attrs}
            class:list={["loose", entry.attrs.class]}
          >
            <span>{entry.label}</span>
            {entry.badge && <Badge {...entry.badge} />}
          </a>
        ) : (
          <section aria-labelledby={`bounda-index-${index}`}>
            <p id={`bounda-index-${index}`} class="bounda-label">
              {entry.label}
            </p>
            <ol>
              {positionsOf([entry]).map(({ link, number }) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={link.isCurrent ? "page" : undefined}
                    {...link.attrs}
                  >
                    <span class="bounda-number">{number}</span>
                    <span>
                      {link.label}
                      {link.badge && <Badge {...link.badge} />}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ),
      )
    }
  </div>
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .bounda-index {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-block: 0.5rem 1rem;
  }

  .bounda-label {
    margin: 0 0 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
    padding: 0.3125rem 0.5rem 0.3125rem 0.625rem;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 160ms cubic-bezier(0.22, 0.8, 0.16, 1);
  }

  a.loose {
    display: block;
    padding-inline-start: 0.625rem;
  }

  a:hover,
  a:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  a[aria-current="page"] {
    background: var(--sl-color-accent-low);
    box-shadow: inset 2px 0 0 var(--sl-color-accent);
    color: var(--sl-color-white);
    font-weight: 600;
  }

  a[aria-current="page"] .bounda-number {
    color: var(--sl-color-accent);
  }
</style>
