---
import { Icon } from "@astrojs/starlight/components";
---

<a href="https://bounda.dev" class="bounda-label">bounda.dev</a>
<a href="https://github.com/bounda-dev/bounda" class="icon" aria-label="GitHub">
  <Icon name="github" size="1.25rem" />
</a>

<style>
  a {
    display: flex;
    align-items: center;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    color: var(--sl-color-white);
  }

  .icon {
    padding: 0.5em;
    margin: -0.5em;
  }
</style>
