---
import { positionsOf } from "../positions.ts";

const { entry, sidebar } = Astro.locals.starlightRoute;
const position = positionsOf(sidebar).find(({ isCurrent }) => isCurrent);
---

{
  position && (
    <p class="bounda-position">
      <span class="bounda-label">{position.group}</span>
      <span class="bounda-number">{position.number}</span>
    </p>
  )
}
<h1 id="_top">{entry.data.title}</h1>

<style>
  .bounda-position {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-top: 1rem;
  }

  .bounda-label {
    color: var(--sl-color-accent);
  }

  .bounda-position + h1 {
    margin-top: 0.5rem;
  }

  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
</style>
