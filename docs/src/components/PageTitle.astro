---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { positionsOf } from "../positions.ts";

const { entry, sidebar } = Astro.locals.starlightRoute;
const position = positionsOf(sidebar).find(({ isCurrent }) => isCurrent);
---

{
  position && (
    <p class="bounda-position">
      <span class="bounda-label">{position.group}</span>
      <span class="bounda-number">{position.number}</span>
    </p>
  )
}
<Default />
{entry.data.description && <p class="lead">{entry.data.description}</p>}

<style>
  .bounda-position {
    margin-top: 1rem;
  }

  .bounda-label {
    color: var(--sl-color-accent);
  }

  .bounda-position + :global(h1) {
    margin-top: 0.5rem;
  }

  .lead {
    max-width: 40rem;
    margin-top: 0.75rem;
    font-size: var(--sl-text-lg);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
</style>
