---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { positionsOf } from "../positions.ts";

const position = positionsOf(Astro.locals.starlightRoute.sidebar).find(
  ({ isCurrent }) => isCurrent,
);
---

{
  position && (
    <p class="bounda-position">
      <span class="bounda-label">{position.group}</span>
      <span class="bounda-number">{position.number}</span>
    </p>
  )
}
<Default />

<style>
  .bounda-position {
    margin-top: 1rem;
  }

  .bounda-label {
    color: var(--sl-color-accent);
  }

  .bounda-position + :global(h1) {
    margin-top: 0.5rem;
  }
</style>
