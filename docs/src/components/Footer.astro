---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "./Pagination.astro";

const year = new Date().getFullYear();
---

<footer>
  {/* Both render nothing until `editLink` or `lastUpdated` is configured. */}
  <div class="meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="end">
    <small>© {year} Bounda</small>
    {/* The ⅃ closes the page, as DESIGN.md has it close what is complete. */}
    <svg class="close" viewBox="0 0 35 65" aria-hidden="true">
      <path fill="currentColor" d="M25 0h10v65H25v-8H0v-6h25z"></path>
    </svg>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .meta:empty {
    display: none;
  }

  .end {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .end small {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .close {
    height: 1.25rem;
    color: var(--sl-color-white);
  }
</style>
