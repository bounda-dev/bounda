---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import { REPOSITORY } from "../site.ts";
import Pagination from "./Pagination.astro";
---

<footer>
  {/* Both render nothing until `editLink` or `lastUpdated` is configured. */}
  <div class="meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="colophon">
    <p>
      <span class="bounda-label">Bounda</span>
      <span class="bounda-number">Apache-2.0</span>
    </p>
    <p class="links">
      <a href={REPOSITORY}>GitHub</a>
      <a href={`${REPOSITORY}/releases`}>Releases</a>
      <a href="/llms.txt">llms.txt</a>
    </p>
    {/* The ⅃ closes the page, as DESIGN.md has it close what is complete. */}
    <svg class="close" viewBox="0 0 35 65" aria-hidden="true">
      <path fill="currentColor" d="M25 0h10v65H25v-8H0v-6h25z"></path>
    </svg>
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: 3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 3rem;
    justify-content: space-between;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .meta:empty {
    display: none;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: end;
    padding-block: 1.25rem 0.5rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  p {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin: 0;
  }

  .bounda-label {
    color: var(--sl-color-gray-3);
  }

  .links {
    gap: 1.25rem;
    font-size: var(--sl-text-sm);
  }

  .links a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--sl-color-white);
  }

  .close {
    margin-inline-start: auto;
    height: 1.25rem;
    color: var(--sl-color-white);
  }
</style>
