{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "semanticCommits": "enabled",
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Madrid",
  "rangeStrategy": "pin",
  "automergeStrategy": "squash",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "groupName": "vitest",
      "matchPackageNames": ["vitest", "@vitest/**"]
    },
    {
      "groupName": "biome",
      "matchPackageNames": ["@biomejs/**"]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": ["typescript"]
    },
    {
      "groupName": "astro",
      "matchPackageNames": ["astro", "@astrojs/**", "starlight-**"]
    },
    {
      "groupName": "react-router stack",
      "matchPackageNames": [
        "react-router",
        "@react-router/**",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "vite",
        "isbot"
      ]
    },
    {
      "groupName": "stryker",
      "matchPackageNames": ["@stryker-mutator/**"]
    },
    {
      "groupName": "opentelemetry",
      "matchPackageNames": ["@opentelemetry/**"]
    },
    {
      "description": "Everything that is not a major lands in one weekly pull request, merged once CI is green.",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "automerge": true
    },
    {
      "description": "A major opens no pull request until it is ticked in the Dependency Dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Below 1.0 a minor may break, so it waits for approval like a major.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "<1.0.0",
      "groupName": "pre-1.0 minors",
      "groupSlug": "pre-1-minors",
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Peer ranges and engines are the support contract of the published packages: widened or raised by hand, never pinned or bumped.",
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    },
    {
      "description": "The Node version is raised by hand, in the workflows as in engines.",
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "astro check accepts TypeScript up to 6, so the docs catalog stays on that major.",
      "matchDepTypes": ["pnpm.catalog.docs"],
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Files laid over the template copies in other repositories: they change with those copies, through pnpm templates:sync.",
      "matchFileNames": ["packages/create-bounda/distribution/**"],
      "enabled": false
    }
  ]
}
