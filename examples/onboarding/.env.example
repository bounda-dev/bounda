# Leave unset to run on SQLite (data/onboarding.db).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onboarding
# console (default) or memory
EMAIL_SENDER=console
# The sender the console implementation writes in its log line
EMAIL_FROM=welcome@onboarding.localhost
# Durations such as 30s, 1m, 7d
WELCOME_EMAIL_DELAY=1m
ONBOARDING_TIMEOUT=7d
